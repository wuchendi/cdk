{
  "name": "@cdk/api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API for cdk.",
  "module": "src/index.ts",
  "scripts": {
    "dev": "nsl run --name cdk:/api bun --env-file=../../.env --watch src/index.ts",
    "dev:bare": "bun --env-file=../../.env --watch src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cdk/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "hono-openapi": "^1.5.0",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cdk/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  }
}
