# Local overrides for `bun run dev:worker` (wrangler dev). Copy to .dev.vars.
NODE_ENV=development
LOG_LEVEL=debug
# ADMIN_TOKEN=change-me-at-least-16-chars
# SHOP_MOCK_PAY=true
# Test payment outside development (any value of 8+ chars):
# SHOP_TEST_PAY_CODE=test-code-123
# Cloudflare Turnstile always-pass TEST keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Use Turso instead of the local D1:
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=
