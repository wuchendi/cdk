# Runtime environment (development | production | test)
NODE_ENV=development
# HTTP port; nsl injects PORT in dev
PORT=3000
# Writable state directory (SQLite, logs); defaults to ./data at the repo root
DATA_DIR=
# Public base URL, used by /api/docs to build the spec link
APP_URL=
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Shop (apps/shop) ---
# Origins allowed to call the API cross-origin, comma-separated (shop and admin URLs)
CORS_ORIGINS=
# Alipay Open Platform (alipay.trade.precreate). Needs APP_URL to be publicly
# reachable: Alipay posts payment results to $APP_URL/api/shop/payments/alipay/notify
ALIPAY_APP_ID=
# App private key and Alipay public key, base64 on one line (or full PEM)
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Override for the sandbox gateway; defaults to https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=
# USDT (TRC20) receiving address and the fixed CNY price of 1 USDT
USDT_TRC20_ADDRESS=
USDT_CNY_RATE=
# Optional TronGrid API key (raises the rate limit)
TRONGRID_API_KEY=
# --- Admin (apps/admin) ---
# Token for the admin console, at least 16 characters, long and random.
# The admin API does not exist while this is empty. Add the admin app's origin
# to CORS_ORIGINS as well.
ADMIN_TOKEN=

# Development only: offer a "mock" payment that issues keys without paying.
# Ignored unless NODE_ENV=development. Never set this on a real deployment.
SHOP_MOCK_PAY=
