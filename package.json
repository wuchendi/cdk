{
  "name": "@cdk/root",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "zod": "^4.6.7"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --filter @cdk/api --filter @cdk/web --filter @cdk/shop --filter @cdk/admin dev",
    "dev:api": "bun --filter @cdk/api dev",
    "dev:web": "bun --filter @cdk/web dev",
    "dev:shop": "bun --filter @cdk/shop dev",
    "dev:admin": "bun --filter @cdk/admin dev",
    "build": "bun --filter @cdk/web --filter @cdk/shop --filter @cdk/admin build && bash ./scripts/assemble-dist.sh",
    "start": "bun --filter @cdk/api start",
    "dev:worker": "bun --filter @cdk/api dev:worker",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:dry": "bash ./scripts/deploy.sh --dry-run",
    "test": "bun --filter '*' test",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "bun --filter '*' typecheck",
    "db:generate": "bun --filter @cdk/api db:generate",
    "db:migrate": "bun --filter @cdk/api db:migrate",
    "db:migrate:d1": "bun --filter @cdk/api db:migrate:d1",
    "db:migrate:d1:local": "bun --filter @cdk/api db:migrate:d1:local",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "bash ./scripts/clean.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cdk/tsconfig": "workspace:*",
    "@dotns/nsl": "^0.2.1",
    "typescript": "catalog:"
  }
}
